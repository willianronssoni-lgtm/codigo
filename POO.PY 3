class Aluno:
   def __init__(self, nome, nota):
       self.nome = nome
       self.nota = nota


   def aprovado(self):
       if self.nota >= 6:
           return True
       else:
           return False


Estudante = Aluno("Juisvaldo da Silva", 0.5)
print(Estudante.nome, "- aprovado?", Estudante.aprovado())


class Retangulo:
    def __init__(self, largura, altura):
        self.largura = largura
        self.altura = altura
    def calcularPerimetro(self):
        return 2 * (self.largura + self.altura)
